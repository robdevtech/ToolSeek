   <item>
    <widget class="Gui::PrefCheckBox" name="checkAllowFuzzy">
     <property name="text">
      <string>Allow fuzzy matching</string>
     </property>
     <property name="toolTip">
      <string>When on, small typos and subsequences can still match. Exact, prefix, and word matches always rank higher.</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
     <property name="prefEntry" stdset="0">
      <cstring>AllowFuzzy</cstring>
     </property>
     <property name="prefPath" stdset="0">
      <cstring>Mod/ToolSeek</cstring>
     </property>
    </widget>
   </item>
   <item>
    <widget class="Gui::PrefCheckBox" name="checkSwitchWorkbench">
     <property name="text">
      <string>Allow selection to switch workbench</string>
     </property>
     <property name="toolTip">
      <string>When on, running a command from another workbench activates that workbench first. When off, the command still runs without switching workbenches.</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
     <property name="prefEntry" stdset="0">
      <cstring>SwitchWorkbench</cstring>
     </property>
     <property name="prefPath" stdset="0">
      <cstring>Mod/ToolSeek</cstring>
