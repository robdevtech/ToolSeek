       </property>
       <property name="prefPath" stdset="0">
        <cstring>Mod/ToolSeek</cstring>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="labelOpenShortcutHint">
     <property name="text">
