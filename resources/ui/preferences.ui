     </item>
     <item>
      <widget class="Gui::PrefLineEdit" name="lineOpenShortcut">
       <property name="toolTip">
        <string>Click then press keys to record the open-palette shortcut (e.g. Ctrl+Space, Alt+P). ToolSeek refuses shortcuts that already belong to another FreeCAD action or command.</string>
